      ["Personal Growth","learning from feedback and improving over time","sprout"]
    ];
    const NAV={teacher:[["home","Mission Control","layout-dashboard"],["students","Students","users"],["analytics","Analytics","chart-no-axes-column"],["reports","PTM Reports","file-text"],["recognition","Achievements","star"],["settings","Settings","settings"]],parent:[["home","Child Overview","users"],["reports","Reports","file-text"],["recognition","Achievements","star"],["settings","Settings","settings"]],student:[["home","My Constellation","orbit"],["garden","Growth Garden","sprout"],["recognition","Achievements","star"],["reports","Reports","file-text"],["settings","Settings","settings"]]};
    let records=[],ready=false,account=null,requestedRole=null,view="home",selectedStudent=null,selectedReport=null,selectedRating=null,range="all",loadTimer;
    const $=id=>document.getElementById(id), esc=s=>String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
    const payload=r=>{try{return JSON.parse(r.payload||"{}")}catch{return {}}};
    const list=t=>records.filter(r=>r.record_type===t);
    const uid=()=>crypto.randomUUID ? crypto.randomUUID() : Date.now().toString(36)+Math.random().toString(36).slice(2);
    const today=()=>new Date().toISOString().slice(0,10), month=()=>today().slice(0,7);
    const date=s=>s?new Date(s+"T12:00:00").toLocaleDateString("en-IN",{day:"numeric",month:"short",year:"numeric"}):"—";
    function notify(text,bad=false){const el=$("toast");el.textContent=text;el.style.background=bad?"#822b3e":"#111B3A";el.classList.remove("hidden");clearTimeout(notify.timer);notify.timer=setTimeout(()=>el.classList.add("hidden"),5000)}
    function icon(name){return `<i data-lucide="${name}" class="inline-block w-4 h-4" aria-hidden="true"></i>`}
    function icons(){if(window.lucide)lucide.createIcons()}
    function heading(title,sub="",back=false){return `<div class="mb-6">${back?'<button type="button" data-action="back" class="text-sm font-bold text-[#075b50] mb-3">← Back</button>':""}<h1 class="serif text-3xl sm:text-4xl font-bold">${esc(title)}</h1>${sub?`<p class="text-slate-600 mt-2">${esc(sub)}</p>`:""}</div>`}
    function empty(t){return `<div class="surface p-7 text-slate-600">${esc(t)}</div>`}
    function pill(t){return `<span class="pill">${esc(t)}</span>`}
    function student(id){return list("student").find(r=>r.record_id===id)}
    function classesOfTeacher(){return list("assignment").filter(r=>r.owner_id===account?.record_id).map(r=>r.text)}
    function visibleStudents(){if(!account)return [];if(account.status==="teacher")return list("student").filter(s=>classesOfTeacher().includes(payload(s).class_id));if(account.status==="parent"){const ids=list("link").filter(r=>r.owner_id===account.record_id).map(r=>r.student_id);return list("student").filter(s=>ids.includes(s.record_id))}return list("student").filter(s=>s.record_id===payload(account).student_id)}
    function allowed(id){return visibleStudents().some(s=>s.record_id===id)}
    function studentLabel(s){const p=payload(s);return `${s.text} · ${s.record_id} · ${p.class_name||"—"} ${p.section||""}`}
    function ratingList(id,q,period){return list("rating").filter(r=>r.student_id===id&&(!q||r.quality===q)&&r.value>=1&&r.value<=5&&(!period||r.period===period)&&!payload(r).superseded_by)}
    function avg(arr){return arr.length?(arr.reduce((n,r)=>n+Number(r.value),0)/arr.length).toFixed(1):null}
    function teacherName(id){return list("user").find(r=>r.record_id===id)?.text||"Teacher"}
    function auditFor(id){return list("audit").filter(r=>r.student_id===id).sort((a,b)=>b.created_at.localeCompare(a.created_at))}
    function formValue(id){return $(id)?.value.trim()||""}
    function envelope(type,data){return {record_type:type,record_id:uid(),student_id:data.student_id||"",owner_id:account.record_id,quality:data.quality||"",value:data.value||0,text:data.text||"",status:data.status||"",event_date:data.event_date||today(),period:data.period||"",payload:JSON.stringify(data.payload||{}),created_at:new Date().toISOString()}}
    async function write(type,data,button){if(records.length>=999){notify("This demo has reached the 999-record limit.",true);return false}if(button){button.disabled=true;button.dataset.old=button.textContent;button.textContent="Saving…"}try{const result=await window.dataSdk.create(envelope(type,data));if(!result.isOk){notify("Could not confirm the save. Refresh and check before trying again.",true);return false}notify("Saved to the Canva Sheet.");return true}catch{notify("Could not confirm the save. Refresh and check before trying again.",true);return false}finally{if(button){button.disabled=false;button.textContent=button.dataset.old}}}
    async function change(record,fields,button){if(button){button.disabled=true;button.dataset.old=button.textContent;button.textContent="Saving…"}try{const result=await window.dataSdk.update({...record,...fields});if(!result.isOk){notify("Could not confirm the update. Refresh and check before trying again.",true);return false}notify("Change saved to the Canva Sheet.");return true}catch{notify("Could not confirm the update. Refresh and check before trying again.",true);return false}finally{if(button){button.disabled=false;button.textContent=button.dataset.old}}}
    async function audit(id,action,ref){return write("audit",{student_id:id,text:action,payload:{reference:ref}})}
    const handler={onDataChanged(data){clearTimeout(loadTimer);records=data;ready=true;renderWelcomeAccounts();if(account){const fresh=list("user").find(r=>r.record_id===account.record_id);if(fresh)account=fresh;else{account=null;showWelcome();return}render()}}};
    async function initialize(){clearTimeout(loadTimer);loadTimer=setTimeout(()=>{if(!ready){$("access-description").textContent="Could not load demo data. Please retry.";notify("Could not load saved data. Select Retry below.",true);$("account-step").innerHTML='<button id="retry-load" class="btn primary w-full">Retry loading</button>'; $("account-step").classList.remove("hidden");$("role-options").classList.add("hidden");$("retry-load").onclick=initialize}},8000);try{const result=await window.dataSdk.init(handler);if(!result.isOk){clearTimeout(loadTimer);notify("Could not initialise the Canva Sheet. Please retry.",true);$("account-step").innerHTML='<button id="retry-load" class="btn primary w-full">Retry loading</button>';$("account-step").classList.remove("hidden");$("role-options").classList.add("hidden");$("retry-load").onclick=initialize}}catch{clearTimeout(loadTimer);notify("Could not connect to the Canva Sheet. Please retry.",true)}}
    function renderWelcomeAccounts(){if(!requestedRole||!$("demo-account"))return;const options=list("user").filter(r=>r.status===requestedRole);$("demo-account").innerHTML=options.map(r=>`<option value="${esc(r.record_id)}">${esc(r.text)} · ${esc(payload(r).demo_label||r.status)}</option>`).join("")}
    function showWelcome(){account=null;selectedStudent=null;view="home";$("app").classList.add("hidden");$("welcome").classList.remove("hidden");$("account-step").classList.add("hidden");$("role-options").classList.remove("hidden");requestedRole=null}
    function enter(){if(!ready)return notify("Demo records are still loading.",true);const chosen=list("user").find(r=>r.record_id===formValue("demo-account")&&r.status===requestedRole);if(!chosen)return notify("Select a valid fictional account.",true);account=chosen;view="home";selectedStudent=null;$("welcome").classList.add("hidden");$("app").classList.remove("hidden");render()}
