  <script>
    const Q=[
      ["Kindness","helping others with care and empathy","heart"],
      ["Inclusion","making others feel welcome and included","users"],
      ["Creativity","original ideas and thoughtful solutions","sparkles"],
      ["Responsibility","ownership of tasks and actions","shield-check"],
