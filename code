    function gardenPage(){if(account.status!=="student")return empty("Student-only view.");let id=payload(account).student_id,goals=list("goal").filter(r=>r.student_id===id),stages=["Seed","Sprout","Grow","Bloom"];return heading("Personal Growth Garden","Follow your own path. Stages reflect your goal progress, never comparison or total stars.")+`<div class="constellation text-white rounded-3xl p-6 mb-6"><div class="flex justify-between items-center gap-2">${stages.map((stage,i)=>`<div class="text-center relative z-10"><div class="text-2xl">${["✦","☽","✧","✺"][i]}</div><span class="text-xs sm:text-sm">${stage}</span></div>`).join("")}</div></div><form id="goal-form" class="surface p-5 grid sm:grid-cols-2 gap-3 mb-5"><div><label class="label" for="goal-quality">Choose a quality</label><select id="goal-quality" class="field">${Q.map(([q])=>`<option>${esc(q)}</option>`).join("")}</select></div><div><label class="label" for="goal-text">Personal next step</label><input id="goal-text" required minlength="8" maxlength="180" class="field" placeholder="A small action I want to practise"></div><button class="btn primary" type="submit">Plant a goal</button></form><div class="space-y-4">${goals.length?goals.map(g=>{let p=payload(g),index=stages.indexOf(p.stage||"Seed"),updates=list("update").filter(u=>payload(u).goal_id===g.record_id);return `<article class="surface p-5"><div class="flex flex-wrap justify-between gap-2"><div><strong>${esc(g.quality)}</strong> · ${esc(g.text)}</div>${pill(g.status==="completed"?"Completed":p.stage||"Seed")}</div><p class="text-sm text-slate-600 mt-2">Your next step: ${esc(p.next_step||g.text)}</p>${updates.map(u=>`<p class="border-t mt-2 pt-2 text-sm">${date(u.event_date)} · ${esc(u.text)}${u.owner_id===account.record_id&&payload(u).reflection?`<br><span class="text-[#6c549c]">Private reflection: ${esc(payload(u).reflection)}</span>`:""}</p>`).join("")}${g.status!=="completed"?`<form data-goal-update="${esc(g.record_id)}" class="mt-4 grid sm:grid